     Ç*****à                           M A I N  L I N E                           Ç*****Ä
     Ç**********************************************************************************Ä
     C*
     C*                  Eval      FileName = 'TESTSRCF'
     C*                  Eval      Library = 'USER01741'
     C*                  Eval      Member =  'TESTSRCMBR'
     C*                  Eval      SourceData = 'aaaaaaaaaa'
     C*                  Eval      Sequence = 1
     C*                  Eval      Action = 'A'
     C                   Select

     C                   When      Action = 'E'
     C                   Close     Source
     C                   Eval      *INLR = *ON
     C                   Eval      Command = 'DLTOVR FILE(SOURCE) ' +
     C                                       'LVL(*JOB)'
     Ç***êCall QCMDEXC                                                                           Ä
     C                   CallP(E)  CmdExec(Command:Length)

     C                   ExSr      EndProgram

     C                   When      Action = 'A'
     C                   Eval      SRCSEQ = NextSequence
     C                   Eval      SRCDTA = SourceData
     C                   Eval      NextSequence = NextSequence + 1
     C                   Except    AddSrc
     C                   ExSr      EndProgram

     C                   When      Action = 'U'
     C     1             Setll     Source
     C                   Read      Source
     C                   Dow       Not %EOF
     C                   If        SRCSEQ = Sequence
     C                   Eval      SRCDTA = SourceData
     C                   Except    UpdSrc
     C                   ExSr      EndProgram
     C                   EndIf
     C                   Read      Source
     C                   EndDo

     C                   When      Action = 'D'
     C     1             Setll     Source
     C                   Read      Source
     C                   Dow       Not %EOF
     C                   If        SRCSEQ = Sequence
     C                   Except    DelSrc
     C                   ExSr      EndProgram
     C                   EndIf
     C                   Read      Source
     C                   EndDo

     C                   EndSl

     Ç***êExit program                                                                            Ä
     C                   ExSr      EndProgram
     Ç**********************************************************************************Ä

