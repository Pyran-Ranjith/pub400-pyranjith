#C CRTBNDCL PGM(QTEMP/&N) SRCFILE(*CURLIB/&F) REPLACE(*YES)
#D CRTDSPF FILE(QTEMP/&N) SRCFILE(*CURLIB/&F)
#R CRTBNDRPG PGM(QTEMP/&N) SRCFILE(*CURLIB/&F)
AB STRCODECMD CMD('CODEBRWS "</ADM>&ZP/&ZL/&ZT/&ZN"')
AD STRCODECMD CMD('CODEDSU "</ADM>&ZP/&ZL/&ZT/&ZN"')
AE STRCODECMD CMD('CODEEDIT "</ADM>&ZP/&ZL/&ZT/&ZN"')
 C CALL QTEMP/&N
CB STRCODECMD CMD('CODEBRWS "<>&L/&F(&N)"')
CC CHGCURLIB CURLIB(&L)
CD STRDFU OPTION(2)
CE STRCODECMD CMD('CODEEDIT "<>&L/&F(&N)"')
CL CHGCURLIB CURLIB(&N)
CM STRSDA OPTION(2) SRCFILE(&L/&F) ??SRCMBR()
CS STRSDA OPTION(1) SRCFILE(&L/&F) ??SRCMBR()
DC STRCODECMD CMD('CODEDSU "<>&L/&F(&N)"')
DM DSPMSG
DP dspusrprf &n
DU dltuser &n
EA EDTOBJAUT OBJ(&L/&N) OBJTYPE(&T)
GO GO &L/&N
JL DSPJOBLOG
RQ RUNQRY QRYFILE((&O/&N *FIRST)) RCDSLT(*YES)
SJ SBMJOB CMD(CALL PGM(&O/&N)) JOB(&N) JOBQ(QBATCH2)
SL SBMJOB ??CMD(SAVLIB LIB(&N))
SM SBMJOB ??CMD(SAVOBJ OBJ(&F) LIB(&L) OBJTYPE(*FILE) FILEMBR((&F (&N))))
SO SBMJOB ??CMD(SAVOBJ OBJ(&N) LIB(&L))
SP WRKSPLF
WS WRKSBMJOB
